//VALID ANAGRAM
class Solution {
public:
    bool isAnagram(string s, string t) {
        if (s.size() != t.size()) {
            return false;
        }

        sort(s.begin(), s.end());
        sort(t.begin(), t.end());

        return s == t;
    }
};
//FIRST UNIQUE CHRACTER
class Solution {
public:
    int firstUniqChar(string s) {
      int arr[26]={0};
      int n=s.length();
      for(int i=0;i<n;i++){
        char ch=s[i];
        arr[ch-'a']++;
      }  
      for(int i=0;i<n;i++){
        char ch=s[i];
        if(arr[ch-'a']==1){
            return i;
        } 
       
      }
      return -1;
    }
    
};
3 RANSOM NOTE
  class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        int freq[26] = {0};

        for(char ch : magazine) {
            freq[ch - 'a']++;
        }

        for(char ch : ransomNote) {
            freq[ch - 'a']--;

            if(freq[ch - 'a'] < 0) {
                return false;
            }
        }

        return true;
    }
};
