//Implement strStr() 
class Solution {
public:
    int strStr(string haystack, string needle) {
        int n = haystack.size();
        int m = needle.size();

        for (int i = 0; i <= n - m; i++) {
            int j = 0;

            while (j < m && haystack[i + j] == needle[j]) {
                j++;
            }

            if (j == m) {
                return i;
            }
        }

        return -1;
    }
};

//Is Subsequence 
class Solution {
public:
    bool isSubsequence(string s, string t) {
        int i = 0;
        int j = 0;

        while (i < s.size() && j < t.size()) {
            if (s[i] == t[j]) {
                i++;
            }
            j++;
        }

        return i == s.size();
    }
};

//. Repeated Substring Pattern

class Solution {
public:
    bool repeatedSubstringPattern(string s) {
        int n = s.size();

        for (int len = 1; len <= n / 2; len++) {

            if (n % len != 0)
                continue;

            string pattern = s.substr(0, len);
            string temp = "";

            int times = n / len;

            for (int i = 0; i < times; i++) {
                temp += pattern;
            }

            if (temp == s)
                return true;
        }

        return false;
    }
};
